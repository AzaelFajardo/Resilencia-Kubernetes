# =====================================================================
# Resilencia-Kubernetes  –  Configuración de entorno
#
# Copia este archivo a `.env` y ajusta los valores según necesites.
# Todos los valores son opcionales: si no se definen, se usan los
# valores por defecto indicados en cada línea.
#
#   cp .env.example .env          (macOS / Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# `docker compose` lee automáticamente el archivo `.env` de la raíz.
# =====================================================================

# ---------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------
# La cadena de conexión que usan todos los microservicios y el seeder.
# Por defecto apunta al contenedor `postgres` que levanta Compose.
# Puedes apuntarla a cualquier base compatible con PostgreSQL
# (PostgreSQL, Neon, RDS/Aurora, Supabase, etc.).
#   Ejemplo externo:
#   DATABASE_URL=postgresql://usuario:clave@mi-host:5432/mi_db
# NOTA: El esquema usa tipos específicos de PostgreSQL (JSONB, enums y
# pgcrypto), por lo que MySQL / SQLite requieren adaptar `db/init.sql`.
DATABASE_URL=postgresql://resilencia:resilencia_secret@postgres:5432/resilencia_db

# Credenciales del contenedor PostgreSQL que crea Compose.
POSTGRES_USER=resilencia
POSTGRES_PASSWORD=resilencia_secret
POSTGRES_DB=resilencia_db

# ---------------------------------------------------------------------
# Puertos (host)
# ---------------------------------------------------------------------
# Los puertos por defecto evitan chocar con otros stacks locales.
# Cambialos aqui si alguno ya esta en uso en tu maquina.
POSTGRES_PORT=5434
ORDER_SERVICE_PORT=8100
USER_SERVICE_PORT=8101
INVENTORY_SERVICE_PORT=8102
PAYMENT_SERVICE_PORT=8103
NOTIFICATION_SERVICE_PORT=8104
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
JAEGER_PORT=16687
JAEGER_GRPC_PORT=14251

# ---------------------------------------------------------------------
# Seed de datos (data-seeder)
# ---------------------------------------------------------------------
# Habilita la carga automática de datos Faker al iniciar Compose.
SEED_ENABLED=true
# Usuarios objetivo (el seeder es idempotente: solo inserta los faltantes).
SEED_USERS_COUNT=50000
# Productos objetivo (0 = no genera productos adicionales).
SEED_PRODUCTS_COUNT=0
# Reintentos y espera al conectar con PostgreSQL.
SEED_CONNECT_RETRIES=30
SEED_CONNECT_DELAY_SECONDS=2
SEED_BATCH_SIZE=1000

# ---------------------------------------------------------------------
# Inyección de fallos / Chaos Engineering
# ---------------------------------------------------------------------
# Probabilidad (0.0 a 1.0) de fallo simulado por petición.
FAILURE_RATE=0.0
# Latencia artificial agregada en milisegundos.
LATENCY_MS=0
# Probabilidad (0.0 a 1.0) de simular un timeout (espera 30s).
TIMEOUT_RATE=0.0

# ---------------------------------------------------------------------
# Resiliencia del order-service
# ---------------------------------------------------------------------
# Reintentos automáticos hacia servicios downstream.
RETRY_ENABLED=false
RETRY_COUNT=3
RETRY_DELAY_MS=100
# Timeout HTTP (segundos) para llamadas entre servicios.
HTTP_TIMEOUT=5.0
# Fraud score threshold above which an order is held for manual review.
FRAUD_THRESHOLD=70

# ---------------------------------------------------------------------
# Observabilidad
# ---------------------------------------------------------------------
# Desactiva por completo el SDK de OpenTelemetry en los 5 microservicios
# (sin instrumentacion, sin trazas exportadas). Util solo para medir el
# overhead de OTel comparando corridas con/sin el; no lo dejes en true
# de forma permanente porque se pierde toda la observabilidad.
OTEL_SDK_DISABLED=false

# Muestreo de trazas (Fase 11). Valores estandar de OTel:
# always_on, always_off, traceidratio, parentbased_always_on (default),
# parentbased_always_off, parentbased_traceidratio.
# OTEL_TRACES_SAMPLER_ARG es el ratio (0.0-1.0) para las variantes *traceidratio*.
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0

# ---------------------------------------------------------------------
# Kubernetes (panel de control, opcional)
# ---------------------------------------------------------------------
# El panel de control (control-panel, puerto 8105) es multiplataforma y su
# integración con Kubernetes es opcional. Deja K8S_API_SERVER vacío para
# desactivarla (el panel responde "Kubernetes not configured").
#
# Para activarla en cualquier SO (Windows, macOS o Linux):
#   1. Copia los certificados de cliente de tu cluster a `k8s/certs/`:
#        ca.crt, client.crt, client.key
#      (en minikube viven en ~/.minikube/ca.crt y
#       ~/.minikube/profiles/minikube/client.{crt,key})
#   2. Define K8S_API_SERVER con el API server del cluster. El puerto de
#      minikube se asigna dinámicamente en cada `minikube start`;
#      encuéntralo con `minikube status` / `kubectl config view`.
#      El contenedor resuelve `host.docker.internal` en cualquier plataforma.
K8S_API_SERVER=
# K8S_CA_FILE=/kube/ca.crt
# K8S_CLIENT_CERT_FILE=/kube/client.crt
# K8S_CLIENT_KEY_FILE=/kube/client.key
#
# NOTA 1: el panel se conecta a la misma bridge network que crea
# `minikube start --driver=docker` (ver compose.yml, networks.minikube).
# Si el panel se levanta con minikube caído, Docker le asigna la IP
# 192.168.49.2 del nodo y `minikube start` falla con "Address already in
# use". Orden de recuperación: docker compose stop control-panel →
# docker start minikube → minikube start → docker compose start control-panel
# (detalles en docs/TOOLING.md "minikube came back Stopped").
#
# NOTA 2: dentro del cluster los 5 microservicios usan estas variables para
# la elección de líder (ver services/shared/orchestrator.py y
# k8s/base/deployment.yaml). No las necesitas en Compose (solo aplican en k8s):
#   SERVICE_NAME            # "order-service" | "user-service" | ...
#   ORCHESTRATOR_PRIORITY   # order=100, payment=80, inventory=60, user=40, notification=20
#   LEADER_ELECTION         # "enabled"/"disabled"; auto se activa dentro de un pod k8s
