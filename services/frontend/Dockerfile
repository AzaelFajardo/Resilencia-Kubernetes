FROM node:20-alpine AS build

WORKDIR /app

ARG VITE_SEED_ENABLED=true
ARG VITE_SEED_USERS_COUNT=50000
ARG VITE_ORDER_SERVICE_PORT=8100
ARG VITE_USER_SERVICE_PORT=8101
ARG VITE_INVENTORY_SERVICE_PORT=8102
ARG VITE_PAYMENT_SERVICE_PORT=8103
ARG VITE_NOTIFICATION_SERVICE_PORT=8104
ARG VITE_PROMETHEUS_PORT=9091
ARG VITE_GRAFANA_PORT=3001
ARG VITE_JAEGER_PORT=16687

ENV VITE_SEED_ENABLED=$VITE_SEED_ENABLED
ENV VITE_SEED_USERS_COUNT=$VITE_SEED_USERS_COUNT
ENV VITE_ORDER_SERVICE_PORT=$VITE_ORDER_SERVICE_PORT
ENV VITE_USER_SERVICE_PORT=$VITE_USER_SERVICE_PORT
ENV VITE_INVENTORY_SERVICE_PORT=$VITE_INVENTORY_SERVICE_PORT
ENV VITE_PAYMENT_SERVICE_PORT=$VITE_PAYMENT_SERVICE_PORT
ENV VITE_NOTIFICATION_SERVICE_PORT=$VITE_NOTIFICATION_SERVICE_PORT
ENV VITE_PROMETHEUS_PORT=$VITE_PROMETHEUS_PORT
ENV VITE_GRAFANA_PORT=$VITE_GRAFANA_PORT
ENV VITE_JAEGER_PORT=$VITE_JAEGER_PORT

COPY package.json ./
COPY package-lock.json ./
COPY tsconfig.json ./
COPY vite.config.ts ./
COPY index.html ./
COPY src ./src

RUN npm ci
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
